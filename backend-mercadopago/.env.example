# Copie este arquivo para ".env" e preencha.
# NUNCA suba o .env para o Git.

# Access Token da conta do Mercado Pago do Caio.
# Painel: https://www.mercadopago.com.br/developers/panel/app
# Use APP_USR-... (produção) ou TEST-... (testes).
MP_ACCESS_TOKEN=

# Domínio onde o biolink está publicado (usado nas back_urls).
URL_SITE=https://caiolivio.art

# URL pública deste backend + /webhook (o Mercado Pago avisa aqui
# quando um pagamento é aprovado). Deixe vazio para desligar.
URL_WEBHOOK=https://api.caiolivio.art/webhook

# Domínios autorizados a chamar este backend (CORS), separados por vírgula.
ORIGENS_PERMITIDAS=https://caiolivio.art,https://www.caiolivio.art

PORTA=3000
